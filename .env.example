# 复制成 .env 再改。这里列出的每一项都会被读取。

# ── 对话模型 ────────────────────────────────────────────────
# 任何兼容 OpenAI Chat Completions 的服务都能接，自建的也行。
# 要求支持流式和 function calling，否则工具循环跑不起来。
# BASE_URL 填到 /chat/completions 之前那一段；PROVIDER 只是显示用的名字。
# 四项配齐并把开关打到 1 才会调远端；否则走本地兜底 responder，回答会标明来源。
TEXT_PROVIDER=
TEXT_BASE_URL=
TEXT_API_KEY=
TEXT_MODEL=
COURSEPILOT_ENABLE_REMOTE_LLM=0
# 厂商私有的请求字段，JSON 对象，原样并入请求体。举例：关掉思考模式换低延迟。
# TEXT_EXTRA_BODY={"thinking":{"type":"disabled"}}

# 想在界面上切换多个模型，就按 _2、_3… 往下加，界面显示成「模型一、模型二」。
# 同一家的第二个模型只要填 MODEL 这一行，BASE_URL / API_KEY / EXTRA_BODY 都继承第一个；
# 换一家就把要改的字段一并填上。扫到断号为止，所以序号不要跳。
# TEXT_MODEL_2=
# TEXT_BASE_URL_2=
# TEXT_API_KEY_2=
# TEXT_EXTRA_BODY_2=

# ── 图片理解（可选）──────────────────────────────────────
# 不配就是不支持图片提问，扫描版（图片版）PDF 也没法转文字。同样要 OpenAI 兼容。
VISION_PROVIDER=
VISION_BASE_URL=
VISION_API_KEY=
# 扫描版 PDF 逐页转录用。这一路只要抄字，量大，用专用 OCR 模型最省。
VISION_MODEL=
# 拍照提问用。留空则复用上面那个。
# 这两件事对模型的要求不同：转录只要抄字，拍题要看懂手写、图表与版面。同一张教材照片实测——
#   专用 OCR 模型只抄出「A B C / Figure 7.6」，还把 SJF 抄成 SJSF；
#   通用多模态模型认出了是哪本教材的哪一页、两张甘特图各自在讲什么、每个任务条的时间区间。
# 代价是转录变长（实测 3200 字 vs 一句话），会多占对话上下文。
VISION_CHAT_MODEL=

# ── 联网检索（可选）────────────────────────────────────────
# 留空时联网工具整体不下发给模型。当前接的是 SerpAPI。
RESEARCH_SERPAPI_API_KEY=
WEB_TIMEOUT_SECONDS=20

# ── 检索 ───────────────────────────────────────────────────
# 向量模型留空则关闭语义检索，只用关键词匹配。换模型后要重建索引。
# 填 auto 则按本机内存与加速器分档（见 core/hardware.py）：
#   有独显 / 统一内存，或内存 ≥ 8 GiB   → bge-base-zh-v1.5 + bge-reranker-v2-m3
#   内存 4~8 GiB                        → bge-small-zh-v1.5 + bge-reranker-base
#   内存 < 4 GiB                        → bge-small-zh-v1.5，重排关掉
# 实测峰值内存（M 系列）：只 import torch 195 MiB、加 sentence-transformers 379 MiB、
# 再加 bge-base 613 MiB、再加 bge-reranker-v2-m3 1118 MiB。换小模型只省几十 MiB，
# 地板是 torch 本身；分档主要省的是磁盘下载量和加载时间。
RAG_EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
RAG_EMBEDDING_DEVICE=auto
RAG_EMBEDDING_BATCH_SIZE=256
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=120
RAG_TOP_K_RESULTS=6
# 重排（cross-encoder）：判「有没有搜到」靠它。留空则关闭重排，退回 RRF 排序、
# 阈值不生效；填 auto 跟着上面的分档走。
# 默认模型磁盘约 2.2 GB（不是内存）。想省磁盘与加载时间可以换 BAAI/bge-reranker-base，
# 它的阈值同样标定过，代价是跨语言不可靠——同一批 chunk，中文问法 0.0095、英文问法 0.9977，
# 而「中文提问打英文教材」正是这个项目的常见场景。
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# 送进重排的候选数（关键词 top-N ∪ 语义 top-N 去重）。20 条在 CPU 上约 0.45 秒。
RAG_RERANK_CANDIDATES=20
# 重排分下限，逐条过滤，全部低于它就等于这次没搜到。
# 留空时只对已标定过的模型自动启用（见 core/settings.py 的 CALIBRATED_RERANK_THRESHOLDS）；
# 换成没标定过的模型时留空表示不过滤——分数是无界 logit 过 sigmoid 得来的，尺度跟着模型走，
# 套别人的阈值等于随机误杀教材内容。要自己标：拿几个确实在教材里的问题和几个确实不在的，
# 各跑一次 POST /api/v2/courses/{id}/knowledge/search，取两组分数之间的值。
RAG_MIN_RERANK_SCORE=
# 召回阶段的余弦下限，默认 0（关闭）。余弦分的绝对值不跨库可比：实测正例最低 0.375、
# 负例最高 0.525，任何取值都会误杀。判「有没有搜到」交给上面的重排分。
RAG_MIN_SIMILARITY=0

# ── 本地运行 ───────────────────────────────────────────────
# 每个用户名一份独立的数据库与文件目录，都放在 STORAGE_DATA_DIR/users/ 下。
# DEFAULT_USER 是请求没带用户名时落到哪个用户，脚本因此不用带请求头。
STORAGE_DATA_DIR=./data
COURSEPILOT_DEFAULT_USER=local
# 日志级别（DEBUG/INFO/WARNING/ERROR）。httpx 这类库会在 DEBUG/INFO 下记完整请求 URL，
# 服务端已单独把它们压到 WARNING，避免把 API key 与检索词写进日志。
LOG_LEVEL=INFO

# ── 上传限额 ───────────────────────────────────────────────
MATERIAL_MAX_BYTES=104857600
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_PIXELS=12000000

# ── 上下文预算 ─────────────────────────────────────────────
# 单位是估算 token：中日韩文字按 1 字 1 token、其余按 3.5 字符 1 token 折算，偏高估。
# 历史占到 HISTORY_TOKEN_BUDGET 的 COMPACT_THRESHOLD_RATIO 就触发压缩；
# 调小这个比例可以在短对话上验证压缩链路。
AGENT_MAX_OUTPUT_TOKENS=8192
AGENT_HISTORY_TOKEN_BUDGET=128000
AGENT_CONTEXT_TOKEN_LIMIT=512000
AGENT_COMPACT_THRESHOLD_RATIO=0.7

# ── 超时与并发 ─────────────────────────────────────────────
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_TOTAL_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
BACKGROUND_JOB_WORKERS=1
BACKGROUND_JOB_QUEUE_CAPACITY=8

# ── 云端检索（可选，给跑不动本地模型的机器）──────────────────
# 把上面的 RAG_EMBEDDING_MODEL / RAG_RERANKER_MODEL 写成 cloud:模型名 就走这组凭据。
# 嵌入用 OpenAI 兼容的 /embeddings（标准接口）；重排没有统一标准，URL 要自己填，
# 请求形状是 {query, documents} → {results:[{index, relevance_score}]}，
# DashScope / Jina / Cohere / TEI 都接近它。
# 代价：每次检索多一个网络往返，而且教材内容会发到模型服务商那里（本地模式不会）。
# 举例（阿里云百炼）：
#   RAG_EMBEDDING_MODEL=cloud:text-embedding-v4
#   RAG_RERANKER_MODEL=cloud:gte-rerank-v2
#   RAG_CLOUD_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   RAG_CLOUD_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RAG_CLOUD_BASE_URL=
RAG_CLOUD_API_KEY=
RAG_CLOUD_RERANK_URL=
