# 对话模型：任何兼容 OpenAI Chat Completions 的服务都能接（自建的也行）。
# BASE_URL 填到 /chat/completions 之前那一段；PROVIDER 只是显示用的名字。
# 四项配齐并把开关打到 1，才会真的调远端；否则一律走本地兜底 responder。
TEXT_PROVIDER=
TEXT_API_KEY=
TEXT_BASE_URL=
TEXT_MODEL=
COURSEPILOT_ENABLE_REMOTE_LLM=0
# 厂商私有的请求字段，JSON 对象，原样并入请求体。举例：关掉思考模式、指定推理档位。
#   TEXT_EXTRA_BODY={"thinking":{"type":"disabled"}}
TEXT_EXTRA_BODY=

# 图片 OCR（可选，不配就是不支持图片提问）。同样要兼容 OpenAI 协议。
VISION_PROVIDER=
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# RAG
RAG_EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
RAG_EMBEDDING_DEVICE=auto
RAG_EMBEDDING_BATCH_SIZE=256
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=120
RAG_TOP_K_RESULTS=6

# Local runtime
STORAGE_DATA_DIR=./data
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
APP_LOG_LEVEL=INFO

# Context and execution budgets
MODEL_CONTEXT_LIMIT_TOKENS=1000000
AGENT_CONTEXT_WINDOW_TOKENS=524288
AGENT_MAX_INPUT_TOKENS=483328
AGENT_MAX_OUTPUT_TOKENS=8192
AGENT_CONTEXT_RESERVE_TOKENS=32768
# 历史预算：当前已生效，以字符数保守近似 token
AGENT_HISTORY_TOKEN_BUDGET=128000
AGENT_MAX_LLM_STEPS=12
AGENT_MAX_TOOL_CALLS=24
AGENT_MAX_PARALLEL_READS=4
SESSION_MAX_ACTIVE_TURNS=1
TOOL_RESULT_MAX_BYTES=65536

# Timeouts and limits
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_FIRST_TOKEN_TIMEOUT_SECONDS=60
LLM_TOTAL_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
SSE_HEARTBEAT_SECONDS=15
SQLITE_BUSY_TIMEOUT_MS=5000
BACKGROUND_JOB_WORKERS=1
BACKGROUND_JOB_QUEUE_CAPACITY=8
SCHEDULER_TICK_SECONDS=60
APPROVAL_TIMEOUT_SECONDS=120
SKILL_ARCHIVE_MAX_BYTES=2097152
MATERIAL_MAX_BYTES=104857600
MATERIAL_MAX_PAGES=1500
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_PIXELS=12000000

# Learning/channel defaults
REPLAN_CONSECUTIVE_INCORRECT=2
REPLAN_PROGRESS_DEVIATION_DAYS=2
CHANNEL_DAILY_PUSH_LIMIT=3
CHANNEL_QUIET_HOURS=22:00-08:00

# 联网检索（SerpAPI）。留空则联网工具整体不下发给模型。
RESEARCH_SERPAPI_API_KEY=
WEB_TIMEOUT_SECONDS=20
