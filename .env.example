# 复制成 .env 再改。这里列出的每一项都会被读取。

# ── 对话模型 ────────────────────────────────────────────────
# 任何兼容 OpenAI Chat Completions 的服务都能接，自建的也行。
# 要求支持流式和 function calling，否则工具循环跑不起来。
# BASE_URL 填到 /chat/completions 之前那一段；PROVIDER 只是显示用的名字。
# 四项配齐并把开关打到 1 才会调远端；否则走本地兜底 responder，回答会标明来源。
TEXT_PROVIDER=
TEXT_BASE_URL=
TEXT_API_KEY=
TEXT_MODEL=
COURSEPILOT_ENABLE_REMOTE_LLM=0
# 厂商私有的请求字段，JSON 对象，原样并入请求体。举例：关掉思考模式换低延迟。
# TEXT_EXTRA_BODY={"thinking":{"type":"disabled"}}

# ── 图片 OCR（可选）────────────────────────────────────────
# 不配就是不支持图片提问，上传附件会返回 feature_disabled。同样要 OpenAI 兼容。
VISION_PROVIDER=
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# ── 联网检索（可选）────────────────────────────────────────
# 留空时联网工具整体不下发给模型。当前接的是 SerpAPI。
RESEARCH_SERPAPI_API_KEY=
WEB_TIMEOUT_SECONDS=20

# ── 检索 ───────────────────────────────────────────────────
# 向量模型留空则关闭语义检索，只用关键词匹配。换模型后要重建索引。
RAG_EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
RAG_EMBEDDING_DEVICE=auto
RAG_EMBEDDING_BATCH_SIZE=256
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=120
RAG_TOP_K_RESULTS=6

# ── 本地运行 ───────────────────────────────────────────────
# 每个用户名一份独立的数据库与文件目录，都放在 STORAGE_DATA_DIR/users/ 下。
# DEFAULT_USER 是请求没带用户名时落到哪个用户，脚本因此不用带请求头。
STORAGE_DATA_DIR=./data
COURSEPILOT_DEFAULT_USER=local

# ── 上传限额 ───────────────────────────────────────────────
MATERIAL_MAX_BYTES=104857600
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_PIXELS=12000000

# ── 上下文预算 ─────────────────────────────────────────────
# 以字符数保守近似 token（按 1 字符 ≤ 1 token 估，宁少勿超窗）。
# 历史占到 HISTORY_TOKEN_BUDGET 的 COMPACT_THRESHOLD_RATIO 就触发压缩；
# 调小这个比例可以在短对话上验证压缩链路。
AGENT_MAX_OUTPUT_TOKENS=8192
AGENT_HISTORY_TOKEN_BUDGET=128000
AGENT_CONTEXT_CHAR_LIMIT=512000
AGENT_COMPACT_THRESHOLD_RATIO=0.7

# ── 超时与并发 ─────────────────────────────────────────────
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_TOTAL_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
BACKGROUND_JOB_WORKERS=1
BACKGROUND_JOB_QUEUE_CAPACITY=8
